# Copia este archivo como .env.local para desarrollo local (nunca subas .env.local a git).
# En producción, estas variables se configuran donde quede hospedado el
# sitio (Vercel: Settings → Environment Variables; en un servidor propio,
# como variables de entorno del proceso Node o del panel de control).

# URL del microservicio Admisiones API (ver carpeta services/admisiones-api).
# El formulario de solicitud de admisión y la pestaña "Solicitudes" del
# panel lo usan en vez de hablarle directo a Supabase.
VITE_ADMISIONES_API_URL=http://localhost:4001

# URL de Pagweb API (ver carpeta services/pagweb-api) — reemplaza el login
# y el CRUD del panel que antes daba Supabase directo. En migración: por
# ahora solo lo usan src/lib/apiClient.js y los archivos que ya se
# cambiaron a ese import (ver database/README.md).
VITE_PAGWEB_API_URL=http://localhost:4000

# El sitio ya no depende de Supabase: login, CRUD del panel y archivos
# los da services/pagweb-api (ver su README). Para dar de alta a quien
# vaya a administrar el contenido, corre `npm run seed-admin` ahí.
