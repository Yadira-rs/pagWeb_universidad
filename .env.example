# Copia este archivo como .env.local para desarrollo local (nunca subas .env.local a git).
# En producción, estas variables se hornean en el build (ver DEPLOY.md):
# para Vercel se configuran en Settings → Environment Variables; para el
# servidor propio, en .env.production.local antes de correr `npm run build`.

# URL de services/admisiones-api. La usan el formulario "Inicia tu
# solicitud" y la pestaña "Solicitudes" del panel.
VITE_ADMISIONES_API_URL=http://localhost:4001

# URL de services/pagweb-api. Da el login del panel y el CRUD del resto
# del contenido editable del sitio.
VITE_PAGWEB_API_URL=http://localhost:4000
