# Copia este archivo como .env.local para desarrollo local (nunca subas .env.local a git).
# En producción, estas variables se configuran en Vercel: Settings → Environment Variables.

# Conexión a la base de datos (Supabase). Sácalas de supabase.com → tu proyecto
# → Settings → API Keys (Project URL y Publishable key). Pídeselas a quien
# creó el proyecto, o entra tú misma si ya te invitaron como colaboradora.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contraseña para entrar a la pantalla de administración de documentos de egresados
# (#/admin/egresados-docs). Elige cualquier contraseña.
ADMIN_PASSWORD=

# BLOB_READ_WRITE_TOKEN no hace falta agregarla a mano: Vercel la crea sola
# en cuanto conectas un almacén de Blob Storage a este proyecto
# (vercel.com → tu proyecto → Storage → Create Database → Blob).
