# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secretos de los microservicios (services/admisiones-api, services/notificaciones-api).
# Cada uno se configura copiando su .env.example a .env; ese .env real nunca se sube.
.env

# Contiene un token de acceso personal de Supabase en texto plano.
scripts/deploy_function.ps1

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
public/docs/Video Informativo Declaración Patrimonial.mp4

# Fotos originales sin comprimir (fuente para recortar/optimizar antes de
# subir a public/imagenes) — no se usan directo en el sitio, muy pesadas
# para versionar.
fotos_directivos/

# Playwright — artefactos de depuración (no son la evidencia final).
# playwright-report/ SÍ se versiona: es la evidencia de ejecución citada
# en INFORME_CALIDAD.md.
/test-results/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Volcados de la base de datos (pueden contener datos reales de
# solicitudes/admisión) — nunca se versionan. Los .sql de esquema en
# database/ y db/ sí se versionan normalmente.
/full_backup.sql
/full_backup.sq
/respaldo_limpio.sql
/data_backup.sql

# Estado local del CLI de Supabase (project ref, versiones, urls) —
# se regenera con `supabase link`, no se versiona.
supabase/.temp/

# Archivos subidos en desarrollo por services/pagweb-api (imágenes del
# panel, documentos de egresados) — carpeta local, no se versiona.
services/pagweb-api/uploads/
