# Copia este archivo como .env y llena los valores reales (nunca subas .env a git).

# Puerto en el que corre este servicio.
PORT=4000

# Origen permitido para CORS: la URL donde corre el frontend en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Conexión al PostgreSQL del servidor de la universidad (los mismos datos
# que usaste con pg_dump/phpPgAdmin: host, puerto, base, usuario, contraseña).
# Para desarrollo local puede apuntar a tu Postgres 18 local en vez del
# servidor real.
PGHOST=localhost
PGPORT=5432
PGDATABASE=feca-ujed-web
PGUSER=
PGPASSWORD=

# Secreto propio para firmar los JWT de sesión del panel admin (ya no es
# Supabase quien los emite). Genera uno largo y aleatorio, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuántos minutos dura la sesión del panel antes de tener que volver a
# iniciar sesión.
JWT_EXPIRES_MINUTES=480

# Cuántos intentos fallidos de login se permiten antes de bloquear la
# cuenta temporalmente, y por cuántos minutos.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Correo de "recuperar contraseña" / invitaciones / avisos ---
# El servicio elige transporte en este orden: 1) Resend si hay
# RESEND_API_KEY, 2) SMTP si hay SMTP_HOST+SMTP_USER+SMTP_PASS,
# 3) "modo consola" (el enlace solo se imprime en `pm2 logs pagweb-api`).
#
# RECOMENDADO sin dominio propio: SMTP de Brevo (https://www.brevo.com).
# 300 correos/día gratis, sin tarjeta. Pasos: crea la cuenta, en
# "Senders" valida tu correo (te llega un mail, das un clic — sin DNS),
# y en "SMTP & API" copia el host, el login y la "SMTP key".
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=xxxxxxxx@smtp-brevo.com   (el login que muestra Brevo)
#   SMTP_PASS=<tu SMTP key de Brevo>
#   MAIL_FROM=FECA <correo-que-validaste@ejemplo.com>
#
# Alternativa: Gmail con contraseña de aplicación (activa 2FA en la
# cuenta y genera una en https://myaccount.google.com/apppasswords):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=tucuenta@gmail.com
#   SMTP_PASS=<contraseña de aplicación de 16 letras>
#   MAIL_FROM=FECA <tucuenta@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Opción Resend (necesita dominio verificado para mandar a cualquier
# destinatario; sin dominio solo llega a tu propia cuenta de Resend).
RESEND_API_KEY=
RESEND_FROM=FECA <onboarding@resend.dev>

# Bandeja que debe recibir el aviso cada vez que alguien responde la
# encuesta de satisfacción (reemplaza al Database Webhook de Supabase).
NOTIFY_EMAIL=

# URL pública del sitio, para armar el enlace del correo de recuperación
# (ej. https://200.23.125.107 en el servidor real).
SITE_URL=http://localhost:5173

# Carpeta donde se guardan los archivos subidos desde el panel (imágenes)
# y los documentos de egresados. En desarrollo, una carpeta local basta.
# En el servidor real, IMPORTANTE: debe quedar FUERA de
# /var/www/html/facultad, porque scripts/deploy.sh borra ahí con
# `rsync --delete` en cada despliegue del sitio (ver DEPLOY.md). Usa algo
# como /var/www/html/facultad-uploads.
UPLOADS_DIR=./uploads
