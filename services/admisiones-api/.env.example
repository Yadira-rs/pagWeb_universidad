# Copia este archivo como .env y llena los valores reales (nunca subas .env a git).

# Puerto en el que corre este servicio.
PORT=4001

# Origen permitido para CORS: la URL donde corre el frontend en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Supabase → Settings → API → Project URL.
SUPABASE_URL=https://zyxmpbgcwlrncsecpzjb.supabase.co

# Supabase → Settings → API → service_role key (secreta, NUNCA la publishable/anon).
# Este servicio la usa para leer/escribir en Postgres directo, sin pasar
# por RLS del navegador, porque corre en un servidor de confianza, no en
# el navegador del visitante.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase → Settings → API → JWT Secret. Sirve para validar localmente
# (sin llamar a Supabase Auth en cada request) el token que manda el panel
# de administración cuando un admin inicia sesión.
SUPABASE_JWT_SECRET=

# URL del servicio de Notificaciones (segundo microservicio del proyecto).
NOTIFICACIONES_API_URL=http://localhost:4002

# Secreto compartido para autenticar las llamadas de este servicio hacia
# Notificaciones API. Debe ser el mismo valor configurado como
# SERVICE_TOKEN en services/notificaciones-api/.env.
SERVICE_TOKEN=cambia-este-valor-por-uno-largo-y-aleatorio
