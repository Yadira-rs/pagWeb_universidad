# Copia este archivo como .env y llena los valores reales (nunca subas .env a git).

# Puerto en el que corre este servicio.
PORT=4001

# Origen permitido para CORS: la URL donde corre el frontend en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Conexión al mismo PostgreSQL que usa services/pagweb-api (mismos valores
# que en su .env.example — este servicio solo lee/escribe la tabla
# solicitudes_admision).
PGHOST=localhost
PGPORT=5432
PGDATABASE=feca-ujed-web
PGUSER=
PGPASSWORD=

# Mismo secreto que JWT_SECRET en services/pagweb-api — así este servicio
# puede validar localmente el token de sesión que emite el login del panel,
# sin llamarle a pagweb-api en cada request.
JWT_SECRET=
