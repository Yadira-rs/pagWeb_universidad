# Copia este archivo como .env y llena los valores reales (nunca subas .env a git).

# Puerto en el que corre este servicio.
PORT=4002

# Secreto compartido para validar que quien llama es un servicio interno
# conocido (hoy solo admisiones-api). Debe ser exactamente el mismo valor
# que SERVICE_TOKEN en services/admisiones-api/.env.
SERVICE_TOKEN=cambia-este-valor-por-uno-largo-y-aleatorio

# API key de https://resend.com para enviar el correo real. Si se deja
# vacío, el servicio sigue funcionando pero solo registra el aviso en
# consola en vez de mandarlo (útil para la demo si no quieren depender de
# Resend en vivo).
RESEND_API_KEY=

# Correo que debe recibir los avisos.
NOTIFY_EMAIL=

# Remitente verificado en Resend.
NOTIFY_FROM=FECA Sitio Web <onboarding@resend.dev>
